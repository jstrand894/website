---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import msu from '../assets/logos/msu2-tight.png';
import umn from '../assets/logos/umn-tight.png';
import * as cv from '../data/cv';

const logos = { msu: { img: msu, alt: 'Montana State University Logo' }, umn: { img: umn, alt: 'University of Minnesota Logo' } };
const toc = [
  ['education', 'Education'],
  ['publications', 'Publications'],
  ['awards', 'Honors & Awards'],
  ['presentations', 'Presentations'],
  ['teaching', 'Teaching'],
  ['service', 'Service'],
  ['events', 'Events'],
  ['employment', 'Employment'],
];
---
<Base title="CV | Jackson Strand" wide>
  <div class="cv-layout">
    <aside class="cv-toc" aria-label="CV sections">
      <a class="btn" href="/JRS_CV.pdf"><span><i class="fa-solid fa-file-pdf"></i> Download CV</span></a>
      {toc.map(([id, label]) => <a href={`#${id}`} data-toc={id}>{label}</a>)}
      <p class="cv-updated">Updated {cv.lastUpdated}</p>
    </aside>

    <div class="cv-content">
      <Section id="education" title="Education">
        {cv.education.map((e) => (
          <Entry logo={logos[e.logo as 'msu' | 'umn'].img} logoAlt={logos[e.logo as 'msu' | 'umn'].alt} sub={e.school} years={e.years} details={e.notes}>
            {e.degree}
          </Entry>
        ))}
      </Section>

      <Section id="publications" title="Publications" link={{ href: '/publications', label: 'Check out my Publications page' }}>
        {cv.publications.map((pub, i) => (
          <div class="pub">
            <span class="pub-num" aria-label={`Publication ${cv.publications.length - i}`}>{String(cv.publications.length - i).padStart(2, '0')}</span>
            <p class="pub-cite" set:html={pub.cite} />
            <div class="pub-actions">
              {pub.status && <span class="chip status">{pub.status}</span>}
              {pub.doi && <a class="chip" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i> DOI</a>}
              <button class="chip copy-cite" type="button" data-doi={pub.doi ?? ''}><i class="fa-regular fa-copy"></i> <span>Copy citation</span></button>
            </div>
          </div>
        ))}
      </Section>

      <Section id="awards" title="Honors & Awards">
        <p class="legend"><i class="fa-solid fa-star featured-star"></i> Featured</p>
        <div data-limit="6">
          {cv.awards.map((a) => (
            <Entry href={a.href} extra={a.extra} years={a.years} details={a.details} featured={a.featured}>{a.title}</Entry>
          ))}
        </div>
      </Section>

      <Section id="presentations" title="Seminars & Presentations" link={{ href: '/talks', label: 'Check out my Talks & Presentations page' }}>
        {cv.presentations.map((group) => (
          <>
            <p class="subhead">{group.heading}</p>
            <ol class="refs numbered" data-limit={group.items.length > 5 ? 4 : undefined}>
              {group.items.map((p, i) => (
                <li>
                  <span class="pub-num" aria-label={`Presentation ${group.items.length - i}`}>{String(group.items.length - i).padStart(2, '0')}</span>
                  <span set:html={p} />
                </li>
              ))}
            </ol>
          </>
        ))}
      </Section>

      <Section id="teaching" title="Teaching">
        {cv.teaching.map((group) => (
          <>
            <p class="subhead">{group.heading}</p>
            <div class="indent" data-limit={group.courses.length > 4 ? 3 : undefined}>
              {group.courses.map((c) => (
                <Entry years={c.lines[0].split(',')[0]} details={[c.lines[0].split(',').slice(1).join(',').trim(), ...c.lines.slice(1)].filter(Boolean)}>
                  {c.title} <span class="entry-sub">({c.code})</span>
                </Entry>
              ))}
            </div>
          </>
        ))}
      </Section>

      <Section id="service" title="Service">
        {cv.service.map((group) => (
          <>
            <p class="subhead">{group.heading}</p>
            <div class="indent">
              {group.items.map((s) => <Entry href={s.href} years={s.years}>{s.title}</Entry>)}
            </div>
          </>
        ))}
      </Section>

      <Section id="events" title="Co-Hosted Events">
        <p class="subhead">{cv.events.heading}</p>
        <div>
          {cv.events.items.map((ev) => (
            <Entry years={ev.date} details={[`Role: ${ev.role}`, `Location: ${ev.location}`, ...(ev.link ? [`Event website: <a href="${ev.link.href}" target="_blank" rel="noopener">${ev.link.text}</a>`] : [])]}>
              {ev.title}
            </Entry>
          ))}
        </div>
      </Section>

      <Section id="employment" title="Employment History">
        {cv.employment.map((j) => (
          <Entry years={j.years} sub={j.place || undefined} href={j.href}>
            {j.org} <span class="entry-sub">— {j.role}</span>
            <Fragment slot="more">
              {j.bullets.length > 0 && <ul class="entry-details">{j.bullets.map((b) => <li>{b}</li>)}</ul>}
            </Fragment>
          </Entry>
        ))}
      </Section>
    </div>
  </div>

  <script>
  let cvCtrl: AbortController | undefined;
  function initCv() {
    if (!document.querySelector('.cv-layout')) return;
    cvCtrl?.abort();
    cvCtrl = new AbortController();
    // Collapsible lists: show the first N children, with a "Show all" button for the rest.
    document.querySelectorAll<HTMLElement>('[data-limit]').forEach((list) => {
      const limit = Number(list.dataset.limit);
      const items = Array.from(list.children) as HTMLElement[];
      if (!limit || items.length <= limit) return;
      items.slice(limit).forEach((el) => el.classList.add('cl-hidden'));
      list.setAttribute('data-collapsed', '');
      list.style.display = 'flow-root'; // keeps the last item's margin inside, so the height doesn't jump when the animation ends
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'show-more';
      const label = (open: boolean) =>
        (btn.innerHTML = open
          ? '<i class="fa-solid fa-chevron-up"></i> Show fewer'
          : `<i class="fa-solid fa-chevron-down"></i> Show all ${items.length}`);
      label(false);
      const hidden = items.slice(limit);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
      let busy = false;
      btn.addEventListener('click', async () => {
        if (busy) return;
        const expanding = list.hasAttribute('data-collapsed');
        label(expanding);
        if (reduce.matches) {
          list.toggleAttribute('data-collapsed', !expanding);
          return;
        }
        busy = true;
        // Scroll anchoring would shift the scroll position when the list changes size; this animation manages scrolling itself.
        document.documentElement.style.overflowAnchor = 'none';
        const from = list.offsetHeight;
        // Measure the other state without painting it.
        list.toggleAttribute('data-collapsed', !expanding);
        const to = list.offsetHeight;
        if (!expanding) list.removeAttribute('data-collapsed'); // stay open while it animates shut
        list.style.overflow = 'hidden';
        list.style.overflowAnchor = 'none';
        const grow = list.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: 500, easing: ease });
        hidden.forEach((el, i) =>
          el.animate(
            expanding
              ? [{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }]
              : [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(10px)' }],
            { duration: 350, delay: Math.min(i * 40, 250), easing: ease, fill: expanding ? 'backwards' : 'forwards' },
          ),
        );
        // Closing: the content below simply moves up. Only if that would carry the button above the nav bar (the reader
        // had scrolled deep into the list) glide back up to the top of the list, frame by frame in step with the shrinking
        // height, since a native smooth scroll fights the changing page height.
        if (!expanding) {
          const navH = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
          const start = window.scrollY;
          const target = list.getBoundingClientRect().top + start - navH;
          if (btn.getBoundingClientRect().top - (from - to) < navH && start > target) {
            const t0 = performance.now();
            const step = (now: number) => {
              const t = Math.min((now - t0) / 500, 1);
              window.scrollTo({ top: start + (target - start) * (1 - Math.pow(1 - t, 4)), behavior: 'instant' });
              if (t < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        }
        try { await grow.finished; } catch {}
        if (!expanding) list.setAttribute('data-collapsed', '');
        list.style.overflow = '';
        list.style.overflowAnchor = '';
        document.documentElement.style.overflowAnchor = '';
        hidden.forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
        busy = false;
      });
      list.after(btn);
    });

    // Copy citation to clipboard.
    document.querySelectorAll<HTMLButtonElement>('.copy-cite').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const cite = btn.closest('.pub')?.querySelector('.pub-cite')?.textContent?.trim() ?? '';
        const doi = btn.dataset.doi;
        try {
          await navigator.clipboard.writeText(doi ? `${cite} https://doi.org/${doi}` : cite);
          const span = btn.querySelector('span')!;
          span.textContent = 'Copied!';
          setTimeout(() => (span.textContent = 'Copy citation'), 1600);
        } catch {}
      });
    });

    // Highlight the section currently being read in the side menu.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
    const sections = links.map((l) => document.getElementById(l.dataset.toc!)!);
    const setActive = () => {
      const line = window.innerHeight * 0.3;
      let current = sections[0];
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s;
      links.forEach((l) => l.classList.toggle('active', l.dataset.toc === current.id));
    };
    window.addEventListener('scroll', setActive, { passive: true, signal: cvCtrl.signal });
    setActive();
  }
  document.addEventListener('astro:page-load', initCv);
  </script>
</Base>
