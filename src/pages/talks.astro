---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { talks, defenseVideo as v, categoryLabels } from '../data/talks';

const years = [...new Set(talks.map((t) => t.year))];
const count = (f: (t: (typeof talks)[number]) => boolean) => talks.filter(f).length;
const stats = [
  { n: talks.length, label: 'talks & presentations' },
  { n: count((t) => t.category === 'conference'), label: 'conference presentations' },
  { n: count((t) => !!t.award), label: 'awards won' },
  { n: new Set(talks.map((t) => t.event.split(' · ')[0])).size, label: 'venues & events' },
];
---
<Base title="Talks & Presentations | Jackson Strand" description="Conference talks, invited seminars and presentations by Jackson R. Strand." wide>
  <div class="talks-page">
    <header class="page-head">
      <p class="eyebrow">Talks &amp; presentations</p>
      <h1>Sharing the science</h1>
      <p>Conference talks, invited seminars, guest lectures and campus presentations on biological control, chemical ecology and integrated pest management.</p>
      <div class="t-stats">
        {stats.map((s) => <div><strong>{s.n}</strong><span>{s.label}</span></div>)}
      </div>
    </header>

    <section class="t-feature">
      <div class="t-video" data-video={v.id}>
        <button class="t-play" type="button" aria-label="Play the thesis defense recording">
          <Image src={v.poster} alt="Thesis defense title slide" width={1000} loading="eager" />
        </button>
      </div>
      <div class="t-feature-text">
        <p class="eyebrow">Featured · {v.date}</p>
        <h2>{v.title}</h2>
        <p class="t-feature-title">{v.heading}</p>
        <p set:html={v.text} />
        <div class="pub-actions">
          <a class="btn" href={v.slides} target="_blank" rel="noopener"><span><i class="fa-solid fa-display"></i> View slides</span></a>
          <a class="btn-ghost" href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener"><span><i class="fa-brands fa-youtube" style="margin-right:.4rem"></i> Open on YouTube</span></a>
        </div>
      </div>
    </section>

    <div class="t-filters" role="group" aria-label="Filter talks">
      <button class="filter-chip active" type="button" data-filter="all">All</button>
      {Object.entries(categoryLabels).map(([k, label]) => <button class="filter-chip" type="button" data-filter={k}>{label}</button>)}
      <button class="filter-chip" type="button" data-filter="award"><i class="fa-solid fa-medal"></i> Awards</button>
    </div>

    <div class="t-timeline">
      {years.map((y) => (
        <section class="t-year" data-year={y}>
          <h2 class="t-year-label">{y}</h2>
          <div class="t-list">
            {talks.filter((t) => t.year === y).map((t) => (
              <article id={`talk-${talks.indexOf(t)}`} class:list={['talk', { 'has-image': t.image }]} data-cat={t.category} data-award={t.award ? '1' : '0'}>
                {t.image && (
                  <a class="talk-media" href={t.image.src} data-fancybox="talks" data-caption={t.imageCaption ?? t.imageAlt}>
                    <Image src={t.image} alt={t.imageAlt ?? ''} width={500} loading="lazy" />
                  </a>
                )}
                <div class="talk-body">
                  <p class="talk-meta">
                    <span class="talk-date">{t.date}</span>
                    {t.format && <span class="tag">{t.format}</span>}
                    {t.award && <span class="award"><i class="fa-solid fa-medal"></i> {t.award}</span>}
                  </p>
                  <h3 set:html={t.title} />
                  <p class="talk-event"><strong set:html={t.event} /> <span class="talk-loc"><i class="fa-solid fa-location-dot"></i> {t.location}</span></p>
                  {t.note && <p class="talk-note">{t.note}</p>}
                  {t.summary && <p class="talk-summary" set:html={t.summary} />}
                  {t.slides && (
                    <a class="chip" href={t.slides} target="_blank" rel="noopener"><i class="fa-solid fa-display"></i> View slides</a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
      <p class="t-empty" hidden>No talks match this filter.</p>
    </div>
  </div>

  <script>
    // Filter chips (one delegated listener; this script only runs once).
    document.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-chip');
      if (!chip) return;
      const f = chip.dataset.filter!;
      document.querySelectorAll('.filter-chip').forEach((c) => c.classList.toggle('active', c === chip));
      let any = false;
      document.querySelectorAll<HTMLElement>('.t-year').forEach((yr) => {
        let shown = 0;
        yr.querySelectorAll<HTMLElement>('.talk').forEach((t) => {
          const ok = f === 'all' || (f === 'award' ? t.dataset.award === '1' : t.dataset.cat === f);
          t.hidden = !ok;
          if (ok) shown++;
        });
        yr.hidden = shown === 0;
        if (shown) any = true;
      });
      document.querySelector<HTMLElement>('.t-empty')!.hidden = any;
    });

    // Click-to-load the YouTube recording (nothing loads from YouTube until you press play).
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.t-play');
      if (!btn) return;
      const wrap = btn.parentElement as HTMLElement;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${wrap.dataset.video}?autoplay=1`;
      iframe.title = 'Master’s thesis defense recording';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      wrap.replaceChildren(iframe);
    });

    // Photo lightbox.
    function initTalks() {
      const F = (window as any).Fancybox;
      if (!F || !document.querySelector('.talks-page')) return;
      F.unbind('[data-fancybox="talks"]');
      F.bind('[data-fancybox="talks"]', { Thumbs: false, Toolbar: { display: ['close', 'prev', 'next'] } });
    }
    document.addEventListener('astro:page-load', initTalks);
  </script>
</Base>
