---
import Base from '../layouts/Base.astro';

const links = [
  { icon: 'fa-solid fa-house', label: 'Home', href: '/' },
  { icon: 'fa-solid fa-user', label: 'About', href: '/about' },
  { icon: 'fa-solid fa-file-lines', label: 'CV', href: '/cv' },
  { icon: 'fa-solid fa-microscope', label: 'Research', href: '/research' },
  { icon: 'fa-solid fa-book', label: 'Publications', href: '/publications' },
  { icon: 'fa-solid fa-microphone', label: 'Talks', href: '/talks' },
  { icon: 'fa-solid fa-newspaper', label: 'Media', href: '/media' },
  { icon: 'fa-solid fa-graduation-cap', label: 'Teaching', href: '/teaching-philosophy' },
  { icon: 'fa-solid fa-toolbox', label: 'Resources', href: '/helpful-resources' },
];
---
<Base title="Page not found | Jackson Strand" description="This page could not be found." noindex>
  <div class="nf">
    <div class="nf-scene" aria-hidden="true">
      <svg class="nf-hills" viewBox="0 0 640 120" preserveAspectRatio="none">
        <path d="M0 120 L0 78 L70 38 L120 70 L205 22 L290 72 L350 44 L430 80 L510 34 L580 66 L640 48 L640 120Z" fill="#e9e0f1" />
        <path d="M0 120 L0 96 L90 70 L170 92 L260 62 L340 94 L430 72 L520 96 L600 78 L640 90 L640 120Z" fill="#d8c9e6" />
      </svg>
      <div class="nf-ground"></div>
      <div class="nf-walker">
        <span class="nf-q q1">?</span><span class="nf-q q2">?</span><span class="nf-q q3">?</span>
        <svg class="nf-weevil" viewBox="26 70 68 36" width="96" height="51">
          <g class="leg l1"><path d="M64 89 L68 100" /></g>
          <g class="leg l2"><path d="M52 94 L52 103" /></g>
          <g class="leg l3"><path d="M38 93 L33 102" /></g>
          <g class="leg l4"><path d="M45 94 L42 103" /></g>
          <g class="body">
            <ellipse cx="46" cy="85" rx="17" ry="11" />
            <ellipse cx="65" cy="83" rx="8.5" ry="7.5" />
            <circle cx="73" cy="82" r="4.6" />
            <path class="snout" d="M76 83.5 Q86.5 85 90 95" />
            <path class="seam" d="M46 75 L46 95" />
            <circle class="eye" cx="74.6" cy="80.8" r="1.3" />
          </g>
        </svg>
      </div>
    </div>
    <p class="eyebrow">Error 404</p>
    <h1>This page wandered off</h1>
    <p class="nf-text">
      The link may be broken, or the page may have moved. Even the weevil is lost. Like most good field sites, it can be tricky to find the first time.
      Here is where most people are headed.
    </p>
    <div class="nf-links">
      {links.map((l) => (
        <a href={l.href}><i class={l.icon}></i> {l.label}</a>
      ))}
    </div>
    <a class="btn" href="/"><span>Back to the home page</span></a>
  </div>
</Base>
