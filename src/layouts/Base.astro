---
import Nav from '../components/Nav.astro';
import { footerLinks, socials, emailScrambled } from '../data/site';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props { title: string; description?: string; wide?: boolean; noindex?: boolean }
const site = (Astro.site ?? new URL('https://jackson-strand.com')).origin;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = `${site}/img/og-image.jpg`;
// Page changes: the old page fades out quickly, the new one eases in from slightly below.
const pageSwap = {
  old: { name: 'page-out', duration: '0.14s', easing: 'ease-in', fillMode: 'forwards' },
  new: { name: 'page-in', duration: '0.4s', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'backwards' },
};
const { title, wide = false, noindex = false, description = 'Jackson R. Strand — PhD student in Ecology & Environmental Science at Montana State University.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#4b2a7b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jackson Strand" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jackson R. Strand, PhD student at Montana State University" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.umd.js"></script>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/webfonts/fa-solid-900.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/webfonts/fa-brands-400.woff2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,600;1,400&family=Noto+Serif:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.css" /></noscript>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-95KDY0HY4C"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-95KDY0HY4C');
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true" transition:persist="progress"></div>
    <Nav />
    <main class:list={['page', { wide }]} transition:animate={{ forwards: pageSwap, backwards: pageSwap }}>
      <slot />
    </main>
    <button class="to-top" type="button" aria-label="Back to top" transition:persist="to-top"><i class="fa-solid fa-chevron-up"></i></button>
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="footer-logo" href="/"><img src="/img/logo.svg" alt="" width="44" height="44" /><span>Jackson R. Strand</span></a>
          <p>PhD student in Ecology &amp; Environmental Science at Montana State University, studying how insects can be used to manage invasive plants.</p>
          <div class="footer-social">
            {socials.map((s) => (
              <a href={s.href} target={s.mail ? undefined : '_blank'} rel="noopener" aria-label={s.text} title={s.text} data-m={s.mail ? emailScrambled : undefined}>
                <i class={`${s.solid ? 'fa-solid' : 'fa-brands'} ${s.icon}`}></i>
              </a>
            ))}
          </div>
        </div>
        {footerLinks.map((g) => (
          <nav class="footer-col" aria-label={g.title}>
            <h2>{g.title}</h2>
            {g.links.map((l) => <a href={l.href}>{l.text}</a>)}
          </nav>
        ))}
      </div>
      <div class="footer-base">
        <span>&copy; {new Date().getFullYear()} Jackson R. Strand</span>
        <span>Built with <a href="https://astro.build">Astro</a> &middot; Updated {new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span>
      </div>
    </footer>
    <script>
      // Turns the scrambled address in data-m into a working mailto: link. Runs on every page load, including
      // page changes that keep the navbar in place.
      function wireEmail() {
        document.querySelectorAll<HTMLAnchorElement>('a[data-m]').forEach((a) => {
          if (a.dataset.wired) return;
          a.href = 'mailto:' + [...a.dataset.m!].reverse().join('');
          a.dataset.wired = '1';
        });
      }
      document.addEventListener('astro:page-load', wireEmail);
    </script>
    <script>
      // Smooth, eased mouse-wheel scrolling on every page. This module runs once and survives page changes.
      import Lenis from 'lenis';

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let lenis: Lenis | undefined;

      // Scroll progress bar, back-to-top button and a menu bar that tucks away while reading down the page.
      const root = document.documentElement;
      let lastY = window.scrollY;
      const onScroll = () => {
        const y = window.scrollY;
        const max = root.scrollHeight - window.innerHeight;
        const bar = document.querySelector<HTMLElement>('.scroll-progress');
        if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max) : 0})`;
        document.querySelector('.to-top')?.classList.toggle('show', y > 700);
        const wrap = document.querySelector<HTMLElement>('.navbar-wrap');
        const menuOpen = !!document.querySelector('.navbar.open');
        const away = y > 240 && y > lastY + 2 && !menuOpen && !wrap?.matches(':hover, :focus-within');
        if (y < 120 || y < lastY - 2 || menuOpen) root.classList.remove('nav-away');
        else if (away) root.classList.add('nav-away');
        lastY = y;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      document.addEventListener('astro:page-load', onScroll);
      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('.to-top')) return;
        if (lenis) lenis.scrollTo(0); else window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });

      // Photos fade in (and sharpen) as they finish loading, instead of popping in.
      const ready = (img: HTMLImageElement) => { img.classList.remove('img-pending'); img.classList.add('img-loaded'); };
      const setupImages = () => {
        document.querySelectorAll<HTMLImageElement>('main img:not([data-fade])').forEach((img) => {
          img.dataset.fade = '1';
          if (img.complete && img.naturalWidth) return;
          img.classList.add('img-pending');
          img.addEventListener('load', () => ready(img), { once: true });
          img.addEventListener('error', () => img.classList.remove('img-pending'), { once: true });
        });
      };
      document.addEventListener('astro:page-load', setupImages);

      // Cards, photos and sections ease in as they scroll into view (the research page has its own version).
      let pending: HTMLElement[] = [];
      const REVEAL = '.cards > .card, .pub-card, .talk, .m-item, .hr-card, .tp-principle, .fs-card, .tile, .ab-figure, article > section, .section-title, .page-head';
      const revealCheck = () => {
        const limit = window.innerHeight * 0.94;
        pending = pending.filter((el) => {
          if (!el.isConnected) return false;
          if (el.getBoundingClientRect().top > limit) return true;
          el.classList.add('in');
          // Once it is in, hand the element back to its normal styles so hover effects behave as usual.
          setTimeout(() => el.classList.remove('rv', 'in'), 1100);
          return false;
        });
      };
      const setupReveal = () => {
        pending = [];
        if (reduce || document.querySelector('.research')) return;
        const seen = new Map<Element, number>();
        document.querySelectorAll<HTMLElement>(REVEAL).forEach((el) => {
          if (el.parentElement?.closest('.rv')) return; // do not nest reveals
          const parent = el.parentElement!;
          const i = seen.get(parent) ?? 0;
          seen.set(parent, i + 1);
          el.style.setProperty('--rv-d', `${Math.min(i, 5) * 0.06}s`);
          el.classList.add('rv');
          pending.push(el);
        });
        void document.body.offsetHeight; // let the hidden state paint first so the first items animate in too
        revealCheck();
      };
      window.addEventListener('scroll', revealCheck, { passive: true });
      window.addEventListener('resize', revealCheck);
      document.addEventListener('astro:page-load', setupReveal);

      if (!reduce) {
        const instance = new Lenis({ anchors: { offset: -96 } });
        lenis = instance;
        const raf = (t: number) => { instance.raf(t); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);

        // Let the photo lightbox lock the page while it is open.
        new MutationObserver(() => {
          if (document.documentElement.classList.contains('with-fancybox')) instance.stop();
          else instance.start();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        // After a page change, start the new page at the top.
        document.addEventListener('astro:after-swap', () => instance.scrollTo(0, { immediate: true, force: true }));
      }
    </script>
  </body>
</html>
